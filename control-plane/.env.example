PORT=8090
DB_PATH=./data/control-plane.db
# E-mails que viram ADMIN + APPROVED automaticamente no primeiro registro
# (resolve o problema do ovo-e-galinha: precisa de um admin pra aprovar o primeiro admin)
ADMIN_EMAILS=voce@exemplo.com

# ── Provisionador Docker (Etapa 2) ──────────────────────────────────────────
# Aponta pro tecnativa/docker-socket-proxy, nunca pro docker.sock cru.
DOCKER_PROXY_HOST=docker-socket-proxy
DOCKER_PROXY_PORT=2375

WORKSPACE_DESKTOP_IMAGE=iagencia-desktop:latest
WORKSPACE_COCKPIT_IMAGE=cockpit:latest
WORKSPACE_DATA_DIR=/var/saas-data/workspaces

# 1 workspace de cliente rodando por vez — teto real do host de referência
# hoje (ver Etapa 2 do plano: já perto do limite de RAM só com a produção
# existente). Suba com cautela, medindo, não por suposição.
MAX_CONCURRENT_WORKSPACES=1
IDLE_TIMEOUT_MIN=10
MAX_SESSION_MIN=60

WORKSPACE_DESKTOP_MEM_MB=1536
WORKSPACE_DESKTOP_CPUS=1
WORKSPACE_COCKPIT_MEM_MB=512
WORKSPACE_COCKPIT_CPUS=0.5
